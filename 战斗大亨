local PlayerTab = Window:Tab({Title = "打玩家", Icon = "solar:user-bold"})

local playerDropdown = PlayerTab:Dropdown({
    Title = "目标玩家",
    Values = getPlayerDisplayNames(),
    Value = "",
    Callback = function(selected)
        targetPlayerName = selected
    end,
})

PlayerTab:Toggle({
    Title = "传送攻击",
    Value = false,
    Callback = function(v)
        toggleTeleportAttack(v)
    end,
})

PlayerTab:Slider({
    Title = "攻击间隔",
    Value = {Min = 0.05, Max = 1, Default = 0.1},
    Step = 0.05,
    Callback = function(v)
        playerAttackInterval = v
    end,
})

task.spawn(function()
    while true do
        task.wait(1)
        local names = getPlayerDisplayNames()
        pcall(function()
            playerDropdown:SetValues(names)
        end)
        if targetPlayerName and targetPlayerName ~= "" then
            local stillHere = false
            for _, n in ipairs(names) do
                if n == targetPlayerName then
                    stillHere = true
                    break
                end
            end
            if not stillHere then
                targetPlayerName = nil
                pcall(function()
                    playerDropdown:SetValue("")
                end)
                if teleportAttackEnabled then
                    teleportAttackEnabled = false
                    if teleportAttackConnection then
                        teleportAttackConnection:Disconnect()
                        teleportAttackConnection = nil
                    end
                end
            end
        end
    end
end)

local MoneyTab = Window:Tab({Title = "偷钱", Icon = "solar:dollar-bold"})

MoneyTab:Button({
    Title = "偷所有 ATM",
    Callback = function()
        stealAllATMs()
