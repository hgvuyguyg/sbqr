task.spawn(function()
    while true do
        task.wait(1)
        findNearestEnemy()
        statusPara:SetDesc(
            "打人机：" .. (autoAttackEnemyEnabled and "✅" or "❌") .. "\n" ..
            "Enemy 数量：" .. enemyCount .. "\n" ..
            "攻击次数：" .. enemyHitCount .. "\n" ..
            "传送攻击：" .. (teleportAttackEnabled and "✅" or "❌") .. "\n" ..
            "目标：" .. (targetPlayerName or "未选择") .. "\n" ..
            "玩家攻击次数：" .. playerHitCount .. "\n" ..
            "ATM 数量：" .. #getAllATMs() .. "\n" ..
