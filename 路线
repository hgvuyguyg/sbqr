    local map = gameFolder:FindFirstChild("map")
    if not map then return nil end
    return map:FindFirstChild("items")
end

local function getAllZombies()
    local zombies = {}
    local folder = getZombiesFolder()
    if not folder then return zombies end
    for _, zombie in pairs(folder:GetChildren()) do
        if zombie:IsA("Model") then
            local humanoid = zombie:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                zombies[#zombies + 1] = zombie
            end
        end
    end
    zombieCount = #zombies
    return zombies
end

local function scanAllItemNames()
    local names = {}
    local seen = {}
    local itemsFolder = getItemsFolder()
    if not itemsFolder then return names end
    for _, obj in pairs(itemsFolder:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Tool") then
            if not seen[obj.Name] then
                seen[obj.Name] = true
                names[#names + 1] = obj.Name
            end
        end
    end
    table.sort(names)
    return names
end

local function attackZombie(zombie)
    if not zombie then return false end
    local hitReg = getHitReg()
    if not hitReg then return false end
    local part = zombie:FindFirstChild("Right Arm") or zombie:FindFirstChild("Left Arm") or zombie:FindFirstChild("HumanoidRootPart") or zombie:FindFirstChild("Torso") or zombie:FindFirstChild("Head") or zombie.PrimaryPart
    if not part then
        for _, child in pairs(zombie:GetChildren()) do
            if child:IsA("BasePart") then
                part = child
                break
            end
        end
    end
    if not part then return false end
    local attackPos = part.Position
    local success = false
    pcall(function()
        hitReg:FireServer(table.unpack({ [1] = zombie, [2] = part, [3] = attackPos }))
        success = true
    end)
    if success then hitCount = hitCount + 1 end
    return success
end

local function toggleKillAura(enabled)
    killAuraEnabled = enabled
    if enabled then
        killAuraConnection = RunService.Heartbeat:Connect(function()
            if not killAuraEnabled then return end
            local now = tick()
            if now - lastAttack < attackInterval then return end
            local zombies = getAllZombies()
            local character = LocalPlayer.Character
            if not character then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for _, zombie in pairs(zombies) do
                local zPart = zombie:FindFirstChild("Right Arm") or zombie:FindFirstChild("HumanoidRootPart") or zombie.PrimaryPart
                if zPart then
                    local distance = (hrp.Position - zPart.Position).Magnitude
                    if distance <= attackRange then
                        attackZombie(zombie)
                    end
                end
            end
            lastAttack = now
        end)
    else
        if killAuraConnection then
            killAuraConnection:Disconnect()
            killAuraConnection = nil
        end
    end
end

local function createZombieESP(zombie)
    if not zombie then return end
    if zombieHighlights[zombie] then return end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = zombie
    
    local head = zombie:FindFirstChild("Head") or zombie:FindFirstChild("HumanoidRootPart") or zombie.PrimaryPart
    local bg = nil
    if head then
        bg = Instance.new("BillboardGui")
        bg.Size = UDim2.new(0, 200, 0, 40)
        bg.AlwaysOnTop = true
        bg.MaxDistance = math.huge
        bg.Parent = head
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = zombie.Name
        label.TextColor3 = Color3.fromRGB(255, 100, 100)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 14
        label.TextStrokeTransparency = 0.5
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Parent = bg
    end
    
    zombieHighlights[zombie] = {H = highlight, B = bg}
end

local function toggleZombieESP(enabled)
    zombieEspEnabled = enabled
    if enabled then
        for _, zombie in pairs(getAllZombies()) do
            createZombieESP(zombie)
        end
    else
        for zombie, data in pairs(zombieHighlights) do
            if data.H and data.H.Parent then data.H:Destroy() end
            if data.B and data.B.Parent then data.B:Destroy() end
        end
        zombieHighlights = {}
    end
end

