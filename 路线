local function enableNightVision()
    originalLighting = {
        Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        ClockTime = Lighting.ClockTime,
        FogEnd = Lighting.FogEnd,
        FogStart = Lighting.FogStart,
        FogColor = Lighting.FogColor,
        GlobalShadows = Lighting.GlobalShadows,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    }
    Lighting.Brightness = 3
    Lighting.Ambient = Color3.fromRGB(180, 180, 180)
    Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.FogStart = 0
    Lighting.GlobalShadows = false
    Lighting.EnvironmentDiffuseScale = 1
    Lighting.EnvironmentSpecularScale = 1
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Brightness = 0.3
    cc.Contrast = 0.1
    cc.Saturation = 0.1
    cc.Parent = Lighting
    nightVisionObjects[#nightVisionObjects + 1] = cc
    local bloom = Instance.new("BloomEffect")
    bloom.Intensity = 1
    bloom.Size = 24
    bloom.Threshold = 1
    bloom.Parent = Lighting
    nightVisionObjects[#nightVisionObjects + 1] = bloom
    for _, child in pairs(Lighting:GetChildren()) do
        if child:IsA("Atmosphere") then child.Density = 0 end
    end
end

local function disableNightVision()
    if originalLighting.Brightness then
        Lighting.Brightness = originalLighting.Brightness
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.FogColor = originalLighting.FogColor
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        Lighting.EnvironmentDiffuseScale = originalLighting.EnvironmentDiffuseScale
        Lighting.EnvironmentSpecularScale = originalLighting.EnvironmentSpecularScale
    end
    for _, obj in pairs(nightVisionObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    nightVisionObjects = {}
end

local function toggleNightVision(enabled)
    nightVisionEnabled = enabled
    if enabled then enableNightVision() else disableNightVision() end
end

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getItemPosition(item)
    if not item then return nil end
    if item:IsA("BasePart") then return item.Position end
    if item:IsA("Model") then
        local p = item.PrimaryPart or item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
    end
    if item:IsA("Tool") then
        local p = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
    end
    return nil
end

local function isExcluded(itemName)
    for _, name in pairs(excludeItems) do
        if name:lower() == itemName:lower() then return true end
    end
    return false
end

local function getAllItems()
    local results = {}
    local itemsFolder = getItemsFolder()
    if not itemsFolder then return results end
    for _, obj in pairs(itemsFolder:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Tool") then
            if not isExcluded(obj.Name) then
                results[#results + 1] = obj
            end
        end
    end
    return results
end

local function pickItem(item)
    if not item then return false end
    local char = getCharacter()
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos = getItemPosition(item)
    if not pos then return false end
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
    hrp.Velocity = Vector3.new(0, 0, 0)
    task.wait(0.1)
    local actions = getActions()
    if actions then
        pcall(function()
            actions:FireServer(table.unpack({ [1] = "pickGroundItem", [2] = item }))
        end)
    end
    task.wait(pickDelay)
    return true
end

local function pickAllItems()
    local count = 0
    for _, item in pairs(getAllItems()) do
        if not pickEnabled then break end
        if pickItem(item) then
            count = count + 1
            pickedCount = pickedCount + 1
        end
    end
    return count
end

local function togglePick(enabled)
    pickEnabled = enabled
    if enabled then
        pickTask = task.spawn(function()
            while pickEnabled do
                local count = pickAllItems()
                if count == 0 then task.wait(1) end
                task.wait(0.1)
            end
        end)
    else
        if pickTask then
            task.cancel(pickTask)
            pickTask = nil
        end
    end
end

local function teleportToCar()
    local char = getCharacter()
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local car = workspace:FindFirstChild("defaultCar", true)
    if not car then
        WindUI:Notify({Title = "传回汽车", Content = "未找到 defaultCar", Duration = 2})
        return false
    end
    local carPos = nil
    if car:IsA("Model") then
        local primary = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
        if primary then carPos = primary.Position end
    elseif car:IsA("BasePart") then
        carPos = car.Position
    end
    if not carPos then return false end
    hrp.CFrame = CFrame.new(carPos + Vector3.new(0, 3, 0))
    hrp.Velocity = Vector3.new(0, 0, 0)
    WindUI:Notify({Title = "传回汽车", Content = "已传送到汽车位置", Duration = 2})
    return true
end

local function getPlayerNames()
    local names = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            names[#names + 1] = plr.Name
        end
    end
    if #names == 0 then names[1] = "无其他玩家" end
    return names
end

local function teleportToPlayer()
    if selectedTarget == "" or selectedTarget == "无其他玩家" then return end
    local target = Players:FindFirstChild(selectedTarget)
    if target and target.Character then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if hrp and targetRoot then
                hrp.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                WindUI:Notify({Title = "传送成功", Content = target.Name, Duration = 2})
            end
        end
    end
end

local function setSpeed(speed)
    local char = getCharacter()
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = speed
        speedValue = speed
    end
end

local function startSpeedBoost()
    if speedConnection then speedConnection:Disconnect() end
    speedConnection = RunService.Heartbeat:Connect(function()
        if not speedEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.WalkSpeed = speedValue end
    end)
end

local function toggleSpeed(enabled)
    speedEnabled = enabled
    if enabled then
        startSpeedBoost()
        setSpeed(speedValue)
    else
        if speedConnection then
            speedConnection:Disconnect()
            speedConnection = nil
        end
        setSpeed(16)
    end
end

